{
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "format": "bun --bun prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts}\"",
    "format:check": "bun --bun prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "5",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ]
}
