# ======================================================
# =================[ GLOBAL SETTINGS ]==================
# ======================================================

PORT=8080

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ======================================================
# =================[ DOCLING PIPELINE ]=================
# ======================================================

DOCLING_MERGE_PEERS=true
DOCLING_MAX_CHUNK_TOKENS=500
DOCLING_ALWAYS_EMIT_HEADINGS=true

# ======================================================
# =================[ QDRANT DATABASE ]==================
# ======================================================

QDRANT_URL=http://qdrant:6333

QDRANT_DISTANCE=Cosine
QDRANT_WRITE_WAIT=true
QDRANT_COLLECTION=atlas
QDRANT_CLIENT_TIMEOUT=10

# Compose-only overrides; missing or empty values use Compose defaults.
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_HOST_PORT=6333

QDRANT_HEALTHCHECK_TIMEOUT=3
QDRANT_HEALTHCHECK_RETRIES=20
QDRANT_HEALTHCHECK_INTERVAL=5
QDRANT_HEALTHCHECK_START_PERIOD=5

# ======================================================
# ================[ POSTGRES DATABASE ]=================
# ======================================================

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password

POSTGRES_PORT=5432

# Compose-only overrides; the internal PostgreSQL port stays 5432.
POSTGRES_IMAGE=postgres:18.6
POSTGRES_HOST_PORT=5432

POSTGRES_HEALTHCHECK_TIMEOUT=3
POSTGRES_HEALTHCHECK_RETRIES=20
POSTGRES_HEALTHCHECK_INTERVAL=5
POSTGRES_HEALTHCHECK_START_PERIOD=5

# ======================================================
# ================[ GOOGLE GEMINI API ]=================
# ======================================================

GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

GEMINI_MAX_OUTPUT_TOKENS=2048

# ======================================================
# =================[ EMBEDDING PIPELINE ]===============
# ======================================================

EMBEDDING_MODEL=BAAI/bge-m3

EMBEDDING_DIMENSION=1024
EMBEDDING_DENSE_KEY=dense_vecs

EMBEDDING_USE_FP16=false
EMBEDDING_RETURN_DENSE=true
EMBEDDING_RETURN_SPARSE=false
EMBEDDING_RETURN_COLBERT_VECS=false

# ======================================================
# =================[ AUTH PRIMITIVES ]===================
# ======================================================

# Optional until access primitives are used. Replace this public example before use.
# Generate a private, persistent secret containing at least 32 UTF-8 bytes.
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
